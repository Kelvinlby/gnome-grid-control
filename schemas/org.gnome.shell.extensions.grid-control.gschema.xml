<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.grid-control" path="/org/gnome/shell/extensions/grid-control/">
    <key name="columns" type="i">
      <range min="1" max="20"/>
      <default>8</default>
    </key>
    <key name="rows" type="i">
      <range min="1" max="12"/>
      <default>4</default>
    </key>
    <key name="icon-size" type="i">
      <range min="0" max="256"/>
      <default>0</default>
      <summary>Icon size in pixels, 0 = largest that fits</summary>
    </key>
    <key name="padding-horizontal" type="i">
      <range min="0" max="1000"/>
      <default>0</default>
    </key>
    <key name="padding-vertical" type="i">
      <range min="0" max="1000"/>
      <default>0</default>
    </key>
  </schema>
</schemalist>
